# Application Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=*
JWT_SECRET=super_secret_jwt_key_change_in_production_12345!
JWT_EXPIRES_IN=1d

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Razorpay (KEY_SECRET never expose to frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CHECKOUT_SESSION_TTL_MINUTES=30
