{
  "name": "cctv-backend",
  "version": "1.0.0",
  "description": "Production-grade modular monolithic backend with ES Modules, Module-Scoped DI, AsyncLocalStorage Request Context, Pino Logger, MongoDB, Redis, AWS S3, Cron Scheduler, and Security Controls",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/main.js",
    "start": "node src/main.js",
    "start:worker": "node src/worker.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "nodejs",
    "express",
    "modular-monolith",
    "dependency-injection",
    "awilix",
    "pino",
    "mongoose",
    "redis",
    "swagger",
    "security",
    "jest"
  ],
  "author": "Engineering Team",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "awilix": "^10.0.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^6.0.11",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.5",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "puppeteer": "^25.5.0",
    "razorpay": "^2.9.8",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "pino-pretty": "^11.2.0",
    "supertest": "^7.0.0"
  }
}
